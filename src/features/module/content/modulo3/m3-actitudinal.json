                  "variant": "body2"
                },
                "score": 100
              },
              {
                "id": "use_all_money",
                "label": {
                  "text": "b) Utilizaría todo el dinero que me queda sin revisar mi presupuesto.",
                  "variant": "body2"
                },
                "score": 70
              },
              {
                "id": "ask_more_money",
                "label": {
                  "text": "c) Pediría más dinero inmediatamente sin analizar otras opciones.",
                  "variant": "body2"
                },
                "score": 70
