            "question": {
              "text": "Organizaste tu presupuesto para la semana y ya habías distribuido todo tu dinero. Sin embargo, aparece un gasto inesperado que no habías considerado. ¿Qué harías en esta situación?",
              "variant": "body1",
              "align": "justify"
            },
            "options": [
              {
                "id": "review_budget",
                "label": {
