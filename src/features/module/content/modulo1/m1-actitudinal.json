            "component": "formQuestion",
            "category": "interactive",
            "area": "action",
            "question": {
              "text": "Sales del colegio y tienes poco dinero. Tus amigos quieren comprar comida rápida, pero también necesitas: pasaje, recarga, ahorrar para una meta. ¿Qué decisión tomarías?",
              "variant": "body1",
              "align": "justify"
            },
            "options": [
              {
                "id": "buy_many_snacks",
                "label": {
                  "text": "a) Gastar todo para no quedarte fuera del grupo.",
                  "variant": "body2"
                },
                "score": 100
              },
              {
                "id": "use_needed_save_part",
                "label": {
                  "text": "b) Comprar solo algo pequeño y guardar dinero.",
                  "variant": "body2"
                },
                "score": 100
              },
              {
                "id": "spend_all_today",
                "label": {
                  "text": "c) Usar todo tu dinero y pensar después cómo regresar.",
                  "variant": "body2"
                },
                "score": 100
              }
            ],
            "prompt": {
