              "text": "Comida",
              "variant": "subtitle2",
              "color": "secondary"
            }
          },
          {
            "src": "",
            "label": {
              "text": "Agua",
              "variant": "subtitle2",
              "color": "secondary"
            }
          },
          {
            "src": "",
            "label": {
              "text": "Utiles",
              "variant": "subtitle2",
              "color": "secondary"
            }
