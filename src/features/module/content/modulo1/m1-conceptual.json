      "template": "teoria",
      "variant": "examples",
      "data": {
        "title": {
          "text": "Consumo responsable",
          "variant": "hero"
        },
        "text": {
          "text": "Consumir responsablemente es decidir con prioridad, presupuesto y calma para evitar compras impulsivas.",
          "variant": "body"
        },
        "examples": [
          {
            "src": "",
            "label": {
              "text": "Comprar lo importante primero",
              "variant": "label",
              "tone": "secondary"
            }
          },
          {
            "src": "",
            "label": {
              "text": "No gastar por impulso",
              "variant": "label",
              "tone": "secondary"
            }
          },
          {
            "src": "",
            "label": {
              "text": "Mirar tu saldo antes de decidir",
              "variant": "label",
              "tone": "secondary"
            }
          }
        ],
        "note": {
          "text": "Consumir mejor no significa dejar de comprar. Significa elegir con criterio.",
          "variant": "supporting"
        }
      }
    },
