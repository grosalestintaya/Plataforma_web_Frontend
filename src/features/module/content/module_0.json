{
  "schemaVersion": "1.0",
  "templates": {
    "t_theory_hero_with_cards": {
      "key": "t_theory_hero_with_cards",
      "layout": {
        "type": "stack",
        "maxWidth": 760,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "subtitleBar" },
          { "slot": "explanation" },
          { "slot": "mediaRow" },
          { "slot": "footerHint" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "subtitleBar": { "block": "SubTitleBar" },
        "explanation": { "block": "TextPanel" },
        "mediaRow": { "block": "CardMediaGrid" },
        "footerHint": { "block": "HintSmall" }
      }
    },

    "t_compare_two_cards": {
      "key": "t_compare_two_cards",
      "layout": {
        "type": "stack",
        "maxWidth": 760,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "subtitleBar" },
          { "slot": "prompt" },
          { "slot": "twoCards" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "subtitleBar": { "block": "SubTitleBar" },
        "prompt": { "block": "TextPanel" },
        "twoCards": { "block": "TwoOptionCards" }
      }
    },

    "t_memory_pairs": {
      "key": "t_memory_pairs",
      "layout": {
        "type": "stack",
        "maxWidth": 860,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "subtitleBar" },
          { "slot": "game" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "subtitleBar": { "block": "SubTitleBar" },
        "game": { "block": "GameMemoryPairs" }
      }
    },

    "t_practice_intro": {
      "key": "t_practice_intro",
      "layout": {
        "type": "twoCol",
        "maxWidth": 860,
        "cols": ["1fr", "1fr"],
        "sections": [
          { "slot": "titleBar", "span": 2 },
          { "slot": "leftPanel" },
          { "slot": "rightMedia" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "leftPanel": { "block": "TextPanel" },
        "rightMedia": { "block": "ImagePanel" }
      }
    },

    "t_practice_start": {
      "key": "t_practice_start",
      "layout": {
        "type": "stack",
        "maxWidth": 860,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "twoPanels" },
          { "slot": "cta" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "twoPanels": { "block": "TwoPanels" },
        "cta": { "block": "PrimaryButton" }
      }
    },

    "t_classification_situation": {
      "key": "t_classification_situation",
      "layout": {
        "type": "stack",
        "maxWidth": 860,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "statusRow" },
          { "slot": "prompt" },
          { "slot": "board" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "statusRow": { "block": "StatusMoneyRow" },
        "prompt": { "block": "TextPanel" },
        "board": { "block": "ClassificationBoard" }
      }
    },

    "t_procedural_success": {
      "key": "t_procedural_success",
      "layout": {
        "type": "stack",
        "maxWidth": 680,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "banner" },
          { "slot": "media" },
          { "slot": "summary" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "banner": { "block": "BannerText" },
        "media": { "block": "ImagePanel" },
        "summary": { "block": "TextPanel" }
      }
    },

    "t_attitudinal_theory": {
      "key": "t_attitudinal_theory",
      "layout": {
        "type": "twoCol",
        "maxWidth": 860,
        "cols": ["1.2fr", "0.8fr"],
        "sections": [
          { "slot": "titleBar", "span": 2 },
          { "slot": "leftText" },
          { "slot": "rightMedia" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "leftText": { "block": "TextPanel" },
        "rightMedia": { "block": "ImagePanel" }
      }
    },

    "t_attitudinal_question_mcq": {
      "key": "t_attitudinal_question_mcq",
      "layout": {
        "type": "stack",
        "maxWidth": 520,
        "sections": [
          { "slot": "titleBar" },
          { "slot": "card" }
        ]
      },
      "slots": {
        "titleBar": { "block": "TitleBar" },
        "card": { "block": "QuestionCardMCQ" }
      }
    }
  },

  "modules": {
    "module_1": {
      "id": "module_1",
      "name": "Necesidades, deseos y consumo responsable",
      "theme": {
        "accent": "#1f4fff",
        "wave": "#f5b400",
        "background": "#1e4cff"
      },

      "missions": {
        "conceptual": {
          "id": "conceptual",
          "name": "Conceptual",
          "views": [
            {
              "id": "m1_c_01_need",
              "template": "t_theory_hero_with_cards",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "¿Qué es una necesidad?" },
                "explanation": {
                  "text": "Una necesidad es algo indispensable para vivir y estar bien (alimentación, salud, educación, seguridad)."
                },
                "mediaRow": {
                  "items": [
                    { "img": "assets/m1/need_comida.png", "label": "Comida" },
                    { "img": "assets/m1/need_salud.png", "label": "Salud" },
                    { "img": "assets/m1/need_educacion.png", "label": "Educación" }
                  ],
                  "columns": 3
                },
                "footerHint": { "text": "Piensa: ¿qué pasaría si no lo tengo?" }
              }
            },

            {
              "id": "m1_c_02_want",
              "template": "t_theory_hero_with_cards",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "¿Qué es un deseo?" },
                "explanation": {
                  "text": "Un deseo es algo que te gustaría tener, pero no es esencial. Puede mejorar tu bienestar o darte placer."
                },
                "mediaRow": {
                  "items": [
                    { "img": "assets/m1/want_juegos.png", "label": "Videojuegos" },
                    { "img": "assets/m1/want_dulces.png", "label": "Dulces" },
                    { "img": "assets/m1/want_ropa.png", "label": "Ropa de marca" }
                  ],
                  "columns": 3
                },
                "footerHint": { "text": "Piensa: ¿puedo vivir sin esto?" }
              }
            },

            {
              "id": "m1_c_03_compare",
              "template": "t_compare_two_cards",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "Necesidad vs Deseo" },
                "prompt": {
                  "text": "La diferencia principal es la prioridad: una necesidad es indispensable; un deseo es opcional."
                },
                "twoCards": {
                  "left": {
                    "title": "Necesidad",
                    "img": "assets/m1/need_example.png",
                    "caption": "Ej.: alimentación / salud"
                  },
                  "right": {
                    "title": "Deseo",
                    "img": "assets/m1/want_example.png",
                    "caption": "Ej.: dulces / juegos"
                  }
                }
              }
            },

            {
              "id": "m1_c_04_consumo_responsable",
              "template": "t_theory_hero_with_cards",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "Consumo responsable" },
                "explanation": {
                  "text": "Consumir responsablemente es pensar antes de comprar: prioriza necesidades, define límites para deseos y evita compras impulsivas."
                },
                "mediaRow": {
                  "items": [
                    { "img": "assets/m1/cr_priorizar.png", "label": "Priorizar" },
                    { "img": "assets/m1/cr_ahorrar.png", "label": "Ahorrar" },
                    { "img": "assets/m1/cr_evitar_impulso.png", "label": "Evitar impulso" }
                  ],
                  "columns": 3
                },
                "footerHint": { "text": "“No comprar” también es una decisión inteligente." }
              }
            },

            {
              "id": "m1_c_05_pairs_1",
              "template": "t_memory_pairs",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "Encuentra los pares" },
                "game": {
                  "mode": "pairs",
                  "grid": { "cols": 4, "rows": 3 },
                  "cards": [
                    { "id": "c1", "img": "assets/m1/pairs/comida.png", "pairId": "p1" },
                    { "id": "c2", "img": "assets/m1/pairs/comida_txt.png", "pairId": "p1" },

                    { "id": "c3", "img": "assets/m1/pairs/salud.png", "pairId": "p2" },
                    { "id": "c4", "img": "assets/m1/pairs/salud_txt.png", "pairId": "p2" },

                    { "id": "c5", "img": "assets/m1/pairs/dulces.png", "pairId": "p3" },
                    { "id": "c6", "img": "assets/m1/pairs/dulces_txt.png", "pairId": "p3" }

                  ],
                  "rules": { "maxAttempts": 12 }
                }
              }
            },

            {
              "id": "m1_c_06_pairs_2",
              "template": "t_memory_pairs",
              "data": {
                "titleBar": { "title": "Necesidades y Deseos" },
                "subtitleBar": { "subtitle": "Encuentra los pares" },
                "game": {
                  "mode": "pairs",
                  "grid": { "cols": 4, "rows": 3 },
                  "cards": [
                    { "id": "c1", "img": "assets/m1/pairs2/educacion.png", "pairId": "p1" },
                    { "id": "c2", "img": "assets/m1/pairs2/educacion_txt.png", "pairId": "p1" },

                    { "id": "c3", "img": "assets/m1/pairs2/juegos.png", "pairId": "p2" },
                    { "id": "c4", "img": "assets/m1/pairs2/juegos_txt.png", "pairId": "p2" },

                    { "id": "c5", "img": "assets/m1/pairs2/ropa.png", "pairId": "p3" },
                    { "id": "c6", "img": "assets/m1/pairs2/ropa_txt.png", "pairId": "p3" }
                  ],
                  "rules": { "maxAttempts": 12 }
                }
              }
            }
          ]
        },

        "procedimental": {
          "id": "procedimental",
          "name": "Procedimental",
          "views": [
            {
              "id": "m1_p_01_intro",
              "template": "t_practice_intro",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "leftPanel": {
                  "text": "Clasificarás productos según la situación. Primero identifica si es necesidad o deseo."
                },
                "rightMedia": {
                  "img": "assets/m1/proc/hero.png",
                  "caption": "Imagen referencial"
                }
              }
            },

            {
              "id": "m1_p_02_start",
              "template": "t_practice_start",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "twoPanels": {
                  "left": { "type": "media", "img": "assets/m1/proc/hero.png", "caption": "Imagen de referencia" },
                  "right": { "type": "text", "text": "Tendrás distintos montos de dinero en cada situación." }
                },
                "cta": { "label": "Iniciar", "action": { "type": "nextView" } }
              }
            },

            {
              "id": "m1_p_03_sit1",
              "template": "t_classification_situation",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "statusRow": { "label": "Situación 1", "money": "S/ 5.00" },
                "prompt": { "text": "Vas al kiosko. Clasifica cada objeto como Necesidad o Deseo." },
                "board": {
                  "items": [
                    { "id": "obj1", "label": "Agua", "img": "assets/m1/proc/agua.png", "correct": "need" },
                    { "id": "obj2", "label": "Gaseosa", "img": "assets/m1/proc/gaseosa.png", "correct": "want" },
                    { "id": "obj3", "label": "Pan", "img": "assets/m1/proc/pan.png", "correct": "need" },
                    { "id": "obj4", "label": "Caramelos", "img": "assets/m1/proc/caramelos.png", "correct": "want" }
                  ],
                  "buckets": [
                    { "id": "need", "title": "Necesidad" },
                    { "id": "want", "title": "Deseo" }
                  ]
                }
              }
            },

            {
              "id": "m1_p_04_sit2",
              "template": "t_classification_situation",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "statusRow": { "label": "Situación 2", "money": "S/ 4.50" },
                "prompt": { "text": "Acompañas a comprar útiles. Clasifica como Necesidad o Deseo." },
                "board": {
                  "items": [
                    { "id": "obj1", "label": "Cuaderno", "img": "assets/m1/proc/cuaderno.png", "correct": "need" },
                    { "id": "obj2", "label": "Lapicero", "img": "assets/m1/proc/lapicero.png", "correct": "need" },
                    { "id": "obj3", "label": "Sticker", "img": "assets/m1/proc/sticker.png", "correct": "want" },
                    { "id": "obj4", "label": "Juguete", "img": "assets/m1/proc/juguete.png", "correct": "want" }
                  ],
                  "buckets": [
                    { "id": "need", "title": "Necesidad" },
                    { "id": "want", "title": "Deseo" }
                  ]
                }
              }
            },

            {
              "id": "m1_p_05_sit3",
              "template": "t_classification_situation",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "statusRow": { "label": "Situación 3", "money": "S/ 2.50" },
                "prompt": { "text": "En casa eliges un gasto. Clasifica como Necesidad o Deseo." },
                "board": {
                  "items": [
                    { "id": "obj1", "label": "Recarga", "img": "assets/m1/proc/recarga.png", "correct": "want" },
                    { "id": "obj2", "label": "Arroz", "img": "assets/m1/proc/arroz.png", "correct": "need" },
                    { "id": "obj3", "label": "Galletas", "img": "assets/m1/proc/galletas.png", "correct": "want" },
                    { "id": "obj4", "label": "Aceite", "img": "assets/m1/proc/aceite.png", "correct": "need" }
                  ],
                  "buckets": [
                    { "id": "need", "title": "Necesidad" },
                    { "id": "want", "title": "Deseo" }
                  ]
                }
              }
            },

            {
              "id": "m1_p_06_done",
              "template": "t_procedural_success",
              "data": {
                "titleBar": { "title": "Clasificación y priorización de gastos" },
                "banner": { "text": "¡Lo lograste!" },
                "media": { "img": "assets/m1/proc/hero.png", "caption": "Celebración" },
                "summary": { "text": "Completaste la prueba. Buen trabajo identificando necesidades y deseos." }
              }
            }
          ]
        },

        "actitudinal": {
          "id": "actitudinal",
          "name": "Actitudinal",
          "views": [
            {
              "id": "m1_a_01_autocontrol",
              "template": "t_attitudinal_theory",
              "data": {
                "titleBar": { "title": "Autocontrol y presión social" },
                "leftText": {
                  "text": "El autocontrol es la capacidad de decidir con calma, aunque tengas ganas de comprar algo en el momento. Ayuda a priorizar necesidades y evitar compras impulsivas."
                },
                "rightMedia": {
                  "img": "assets/m1/att/hero.png",
                  "caption": "Imagen referencial"
                }
              }
            },

            {
              "id": "m1_a_02_presion_social",
              "template": "t_attitudinal_theory",
              "data": {
                "titleBar": { "title": "Autocontrol y presión social" },
                "leftText": {
                  "text": "La presión social ocurre cuando decides por influencia de amigos o del entorno. Antes de gastar, pregúntate si es tu decisión o solo para encajar."
                },
                "rightMedia": {
                  "img": "assets/m1/att/hero.png",
                  "caption": "Imagen referencial"
                }
              }
            },

            {
              "id": "m1_a_03_question_1",
              "template": "t_attitudinal_question_mcq",
              "data": {
                "titleBar": { "title": "Necesidades, deseos y consumo responsable" },
                "card": {
                  "questionTitle": "Pregunta 1",
                  "question": "“Tienes 10 soles, ¿lo gastas en dulces o lo guardas para el libro que quieres?”",
                  "options": [
                    { "id": "a", "label": "Lo gasto" },
                    { "id": "b", "label": "Lo guardo" }
                  ],
                  "followUp": { "type": "openText", "label": "Explica: ¿Por qué?" }
                }
              }
            },

            {
              "id": "m1_a_04_question_2",
              "template": "t_attitudinal_question_mcq",
              "data": {
                "titleBar": { "title": "Necesidades, deseos y consumo responsable" },
                "card": {
                  "questionTitle": "Pregunta 2",
                  "question": "“Tus amigos compran algo caro. ¿Tú también lo compras aunque no lo necesites?”",
                  "options": [
                    { "id": "a", "label": "Sí, para no quedar mal" },
                    { "id": "b", "label": "No, decido según mi prioridad" }
                  ],
                  "followUp": { "type": "openText", "label": "Explica: ¿Por qué?" }
                }
              }
            }
          ]
        }
      }
    }
  }
}