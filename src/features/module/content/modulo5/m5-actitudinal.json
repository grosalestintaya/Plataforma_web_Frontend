                "score": 70
              },
              {
                "id": "m5a_s1_review",
                "label": {
                  "text": "b) Revisar si realmente lo necesitas, cuanto costara y si podras pagarlo despues.",
                  "variant": "body2"
                },
                "score": 100
              },
              {
                "id": "m5a_s1_half",
