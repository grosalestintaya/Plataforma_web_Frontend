        "compound": [
          {
            "type": "formQuestion",
            "component": "formQuestion",
            "category": "interactive",
            "area": "action",
            "question": {
              "text": "Necesitas dinero para comprar algo que deseas. Mientras caminas, encuentras un anuncio que ofrece dinero de forma inmediata y con muy poca información. ¿Qué harías en esta situación?",
              "variant": "body1",
              "align": "justify"
            },
            "options": [
              { "id": "m5a_s1_rush", "label": { "text": "a) Aceptaría el préstamo sin preguntar más detalles.", "variant": "body2" }, "score": 70 },
              { "id": "m5a_s1_review", "label": { "text": "b) Buscaría información antes de tomar una decisión.", "variant": "body2" }, "score": 100 },
              { "id": "m5a_s1_alt", "label": { "text": "c) Preferiría buscar otra alternativa antes de aceptar el préstamo.", "variant": "body2" }, "score": 85 }
            ],
            "prompt": {
              "text": "¿Por qué elegirías esa opción? (Opcional)",
              "variant": "helper"
            },
            "placeholder": "Explica tu razón...",
            "minReasonLength": 12,
            "reasonRequired": false
          }
        ]
      },
      "navigation": {
        "mode": "lockedUntilComplete"
      },
      "completionCriteria": {
        "type": "interaction",
        "required": "selectOption"
      }
    },
